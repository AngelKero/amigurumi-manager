# ==============================================================================
# Apache Web Server Security Configuration - Crochet Manager Micro-ERP
# ==============================================================================

# 1. Disable Directory Indexing / Directory Browsing
Options -Indexes

# ------------------------------------------------------------------------------
# 2. Forward HTTP Authorization Header (FastCGI / Apache Bearer Token Pass)
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

# ------------------------------------------------------------------------------
# 3. Strictly Block Direct Web Access to Sensitive Directories
#    (app/, database/, spec/, logs/, tests/)
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Return 403 Forbidden for any request attempting to access protected folders
    RewriteRule ^(app|database|logs|tests|spec)(/.*)?$ - [F,L,NC]
</IfModule>

<IfModule mod_authz_core.c>
    <DirectoryMatch "^.*/(app|database|logs|tests|spec)(/.*)?$">
        Require all denied
    </DirectoryMatch>
</IfModule>

<IfModule !mod_authz_core.c>
    <DirectoryMatch "^.*/(app|database|logs|tests|spec)(/.*)?$">
        Order allow,deny
        Deny from all
    </DirectoryMatch>
</IfModule>

# ------------------------------------------------------------------------------
# 3. Strictly Deny Web Access to Sensitive File Extensions
#    (.sqlite, .sqlite3, .sql, .md)
# ------------------------------------------------------------------------------
<FilesMatch "\.(sqlite|sqlite3|sql|md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ------------------------------------------------------------------------------
# 4. Block Hidden Files, Configuration, and Version Control Artifacts
#    (.git, .env, .htaccess, etc.)
# ------------------------------------------------------------------------------
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ==============================================================================
# Apache Web Server Security Configuration - Crochet Manager Micro-ERP
# ==============================================================================

# 1. Disable Directory Indexing / Directory Browsing
Options -Indexes

# ------------------------------------------------------------------------------
# 2. Forward HTTP Authorization Header (FastCGI / Apache Bearer Token Pass)
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

# ------------------------------------------------------------------------------
# 3. Strictly Block Direct Web Access to Sensitive Directories
#    (app/, database/, spec/, logs/, tests/)
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Return 403 Forbidden for any request attempting to access protected folders
    RewriteRule ^(app|database|logs|tests|spec)(/.*)?$ - [F,L,NC]
</IfModule>

<IfModule mod_authz_core.c>
    <DirectoryMatch "^.*/(app|database|logs|tests|spec)(/.*)?$">
        Require all denied
    </DirectoryMatch>
</IfModule>

<IfModule !mod_authz_core.c>
    <DirectoryMatch "^.*/(app|database|logs|tests|spec)(/.*)?$">
        Order allow,deny
        Deny from all
    </DirectoryMatch>
</IfModule>

# ------------------------------------------------------------------------------
# 3. Strictly Deny Web Access to Sensitive File Extensions
#    (.sqlite, .sqlite3, .sql, .md)
# ------------------------------------------------------------------------------
<FilesMatch "\.(sqlite|sqlite3|sql|md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ------------------------------------------------------------------------------
# 4. Block Hidden Files, Configuration, and Version Control Artifacts
#    (.git, .env, .htaccess, etc.)
# ------------------------------------------------------------------------------
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ------------------------------------------------------------------------------
# 5. Gzip / Deflate Compression (Performance & Core Web Vitals)
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
    AddOutputFilterByType DEFLATE application/json application/xml application/xhtml+xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ------------------------------------------------------------------------------
# 6. Browser Caching & Expiration Directives (Static Assets Performance)
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 day"

    # CSS & JavaScript (7 days)
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType text/javascript "access plus 7 days"

    # Images & SVG (30 days)
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/x-icon "access plus 30 days"

    # Fonts (1 year)
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

# ------------------------------------------------------------------------------
# 7. Cache-Control Headers for Static Assets
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
    <FilesMatch "\.(ico|jpe?g|png|webp|svg)$">
        Header set Cache-Control "max-age=2592000, public"
    </FilesMatch>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "max-age=604800, public"
    </FilesMatch>
    <FilesMatch "\.(woff|woff2|ttf)$">
        Header set Cache-Control "max-age=31536000, public"
    </FilesMatch>
</IfModule>
